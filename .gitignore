# Shared monorepo rules: apply at any depth unless anchored with /.
# Keep sources, Xcode projects/shared schemes, dependency lockfiles,
# migrations, contracts, assets and deliberate test evidence versionable.

# OS metadata and editor-local state
.DS_Store
._*
Thumbs.db
Desktop.ini
.idea/
*.swp
*.swo
*~

# Xcode / Swift generated output and per-user settings
DerivedData/
build/
.build/
.swiftpm/
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.xcarchive/
*.xcresult/
*.dSYM/
*.dSYM.zip
*.ipa
*.app/

# Python environments, caches, packaging and test output
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
*.egg-info/
.eggs/
dist/

# Local configuration and signing credentials; retain safe examples
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.template
*.p12
*.p8
*.mobileprovision
*.provisionprofile

# Dependency/install/build caches for future web tooling
node_modules/
.svelte-kit/
.next/
.npm/
.pnpm-store/

# Deliberately local runtime data; never put authored assets here
.local/
